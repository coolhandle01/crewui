Screen {
    layout: horizontal;
    background: $background;
}

#sidebar {
    width: 34;
    border-right: solid $surface;
    padding: 1 1;
    layout: vertical;
    overflow-y: auto;
}

#sidebar-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

.phase-heading {
    color: $accent;
    text-style: bold;
    margin-top: 1;
}

.task-name {
    color: $text-muted;
    padding-left: 2;
}

.task-name.running {
    color: $warning;
    text-style: bold;
}

.task-name.done {
    color: $success;
}

.task-status {
    color: $text-muted;
    padding-left: 4;
    height: 1;
}

.task-status.running {
    color: $warning;
}

.task-status.done {
    color: $success;
}

#metrics {
    dock: bottom;
    border-top: solid $surface;
    padding: 1;
    color: $text-muted;
    height: 8;
}

#main {
    layout: vertical;
    width: 1fr;
}

/* The panes own the horizontal inset so every child - title, scroll, input -
   shares one left/right rhythm, and the two scrollables' bars land in the same
   column (a child's own margin would shrink its siblings and skew that). */
#messages-pane {
    height: 60%;
    border-bottom: solid $surface;
    layout: vertical;
    padding: 0 1;
}

.pane-title {
    color: $accent;
    text-style: bold;
    height: 1;
}

#agent-session {
    height: 1fr;
    overflow-y: auto;
    scrollbar-gutter: stable;
}

/* One container per agent turn: role and model on the top rail, per-turn token
   cost on the bottom rail (border_subtitle, set on completion). Holds the
   agent's text plus any tool-call boxes, in the order they happened. */
.agent-turn {
    border: round $success;
    border-title-align: left;
    border-subtitle-align: right;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
}

/* The agent's own prose within a turn - a run of streamed text between tool
   calls. Bare (no border); the turn container carries the frame. */
.agent-text {
    height: auto;
}

/* A tool call within a turn: collapsed by default (Collapsible) so a long
   result stays folded away; dimmed so it reads as secondary to the prose. The
   header rail carries `> tool(args)`, stamped with the outcome on completion. */
.tool-call {
    height: auto;
    color: $text-muted;
    margin: 0;
}

.tool-out {
    height: auto;
    color: $text-muted;
}

/* The agent's extended thinking, streamed in as it reasons - collapsed by
   default (long and secondary), dim and italic so it sits behind the prose.
   Expand it to read how the agent got to its answer. */
.reasoning-box {
    height: auto;
    color: $text-muted;
    text-style: italic;
    margin: 0;
}

.reasoning-out {
    height: auto;
    color: $text-muted;
}

/* The human-review prompt - unmissable, centred title. */
.gate-box {
    border: round $warning;
    border-title-align: center;
    color: $warning;
    height: auto;
    margin: 1 0 0 0;
    padding: 1 2;
}

/* The run's end: a centred labelled rule in the flow (-- pipeline complete --),
   no box and no content - the deliverable already sits in the last agent turn. */
.finish-rule {
    height: auto;
    margin: 1 0 0 0;
}

/* An echoed operator turn: blue, labelled "you" on the right rail to mirror
   the agent boxes. This is where the "you" branding lives - not the input box. */
.you-box {
    border: round $primary;
    border-title-align: right;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
}

/* The input box is a plain editor, not a decorated turn - the sent message
   (.you-box) carries the "you" identity once submitted. */
#human-input {
    height: 5;
    margin-bottom: 1;
}

#human-input:disabled {
    opacity: 0.4;
}

#logs-pane {
    height: 40%;
    layout: vertical;
    padding: 0 1;
}

#logs-title {
    color: $text-muted;
    text-style: bold;
    height: 1;
}

#crew-log {
    height: 1fr;
    scrollbar-gutter: stable;
}
